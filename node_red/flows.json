[
  {
    "id": "pdm-flow",
    "type": "tab",
    "label": "Maintenance AI4I — branche optionnelle",
    "disabled": true,
    "info": "Activer après arrêt du consumer Python. Validation canonique et features calculées par API."
  },
  {
    "id": "pdm-subflow",
    "type": "subflow",
    "name": "Valider une mesure AI4I",
    "info": "Sous-flux réutilisable. API_URL paramétrable. Le schéma Python reste autoritaire.",
    "in": [
      {
        "x": 40,
        "y": 80,
        "wires": [
          {
            "id": "pdm-validate"
          }
        ]
      }
    ],
    "out": [
      {
        "x": 440,
        "y": 80,
        "wires": [
          {
            "id": "pdm-validate",
            "port": 0
          }
        ]
      }
    ],
    "env": [
      {
        "name": "API_URL",
        "type": "str",
        "value": "http://api:8000"
      }
    ]
  },
  {
    "id": "pdm-validate",
    "type": "function",
    "z": "pdm-subflow",
    "name": "Valider le contrat",
    "func": "const p = msg.payload;\nif (!p || typeof p !== 'object') { node.error('Objet JSON requis', msg); return null; }\nconst names = ['air_temperature_k','process_temperature_k','rotational_speed_rpm','torque_nm','tool_wear_min'];\nif (!['L','M','H'].includes(p.type) || !p.message_id || !p.machine_id || !p.sent_at) { node.error('Champs obligatoires invalides',msg); return null; }\nfor (const key of names) { if (typeof p[key] !== 'number' || !Number.isFinite(p[key]) || p[key] < 0) { node.error('Mesure invalide: '+key,msg); return null; } }\nmsg.url = env.get('API_URL') + '/api/telemetry';\nmsg.headers = {'Content-Type':'application/json'};\nreturn msg;",
    "outputs": 1,
    "x": 240,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "pdm-broker",
    "type": "mqtt-broker",
    "name": "Mosquitto local",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "pdm-nodered",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": false
  },
  {
    "id": "pdm-in",
    "type": "mqtt in",
    "z": "pdm-flow",
    "name": "Mesures QoS 1",
    "topic": "industrie/+/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "pdm-broker",
    "x": 130,
    "y": 100,
    "wires": [
      [
        "pdm-use"
      ]
    ]
  },
  {
    "id": "pdm-use",
    "type": "subflow:pdm-subflow",
    "z": "pdm-flow",
    "x": 370,
    "y": 100,
    "wires": [
      [
        "pdm-http"
      ]
    ]
  },
  {
    "id": "pdm-http",
    "type": "http request",
    "z": "pdm-flow",
    "name": "Inférence + stockage",
    "method": "POST",
    "ret": "obj",
    "url": "",
    "persist": true,
    "x": 620,
    "y": 100,
    "wires": [
      [
        "pdm-debug"
      ]
    ]
  },
  {
    "id": "pdm-debug",
    "type": "debug",
    "z": "pdm-flow",
    "name": "Prédiction / code HTTP",
    "active": true,
    "tosidebar": true,
    "complete": "true",
    "x": 870,
    "y": 100,
    "wires": []
  },
  {
    "id": "pdm-catch",
    "type": "catch",
    "z": "pdm-flow",
    "scope": null,
    "uncaught": false,
    "x": 380,
    "y": 200,
    "wires": [
      [
        "pdm-debug"
      ]
    ]
  }
]